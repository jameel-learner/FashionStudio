# Copy this file to .env and fill in ONE provider key.

#OPENAI_API_KEY=
OPENROUTER_API_KEY=
MODEL=openrouter/openai/gpt-4o-mini
# Or use a free Groq key instead (uncomment both lines):
# GROQ_API_KEY=
# MODEL=groq/llama-3.3-70b-versatile

# Or Gemini:
# GEMINI_API_KEY=
# MODEL=gemini/gemini-2.0-flash

# Default model when MODEL is not set: openai/gpt-4o-mini
